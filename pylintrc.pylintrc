[MASTER]
ignore=tests
load-plugins=pylint.extensions.docparams

[MESSAGES CONTROL]
disable=
    missing-docstring,
    invalid-name,
    too-few-public-methods,
    too-many-arguments,
    too-many-instance-attributes,
    too-many-locals,
    duplicate-code,
    broad-except,
    no-self-use,
    protected-access,
    no-member,
    unused-argument,
    fixme,
    line-too-long,
    consider-using-f-string.

enable=
    unused-import,
    redefined-outer-name,
    no-else-return

[FORMAT]
max-line-length=100
indent-string='    '

[SIMILARITIES]
min-similarity-lines=8

[DESIGN]
max-args=8
max-attributes=15
max-locals=20
max-returns=6

[LOGGING]
logging-format-style=new

[VARIABLES]
dummy-variables-rgx=_.*|dummy

[TYPECHECK]
ignored-modules=fastapi,sqlalchemy,pydantic,jose,passlib,bcrypt